{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "game server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/gameserver/main.go",
            "env": {
                "DS_CONFIGPATH": "${workspaceFolder}",
                "DS_GS_PORT": "20000",
                "DS_DSC_GRPC_URI": "127.0.0.1:10000",
                "DS_MONGOURI": "mongodb://172.17.0.1:27017",
                "DS_MONGODBNAME": "ds",
                "DS_REDISURI": "172.17.0.1:7001,172.17.0.1:7002"
            },
            "args": [],
            "showLog": true
        },
        {
            "name": "dsc server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/dscserver/main.go",
            "env": {
                "DS_CONFIGPATH": "${workspaceFolder}",
                "DS_DSC_PORT": "10000",
                "DS_REDISURI": "172.17.0.1:7001,172.17.0.1:7002"
            },
            "args": [],
            "showLog": true
        },
        {
            "name": "dsa server",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mode": "debug",
            "program": "${workspaceFolder}/dsaserver/main.go",
            "env": {
                "DS_CONFIGPATH": "${workspaceFolder}",
                "DS_DSA_PORT": "11000",
                "DS_DSA_GRPC_PORT": "12000",
                "DS_DSA_GRPC_ADDR": "127.0.0.1:12000",
                "DS_DSC_GRPC_URI": "127.0.0.1:10000",
                "DS_DSA_AgentID": "AgentID0"
            },
            "args": [],
            "showLog": true
        }
    ]
}
