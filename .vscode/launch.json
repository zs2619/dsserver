{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "game server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/gameserver/main.go",
            "env": {
                "DS_CONFIGPATH": "${workspaceFolder}",
                "DS_GS_PORT": "20000",
                "DS_DSC_GRPC_URI": "127.0.0.1:10000",
                "DS_MONGOURI": "mongodb://mongodb-server:27017",
                "DS_MONGODBNAME": "ds",
                "DS_REDISURI": "redis-node-1:7001,redis-node-2:7002,redis-node-3:7003,redis-node-4:7004,redis-node-5:7005,redis-node-6:7006"
            },
            "args": [],
            "showLog": true
        },
        {
            "name": "dsc server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/dscserver/main.go",
            "env": {
                "DS_CONFIGPATH": "${workspaceFolder}",
                "DS_DSC_PORT": "10000",
                "DS_REDISURI": "redis-node-1:7001,redis-node-2:7002,redis-node-3:7003,redis-node-4:7004,redis-node-5:7005,redis-node-6:7006"
            },
            "args": [],
            "showLog": true
        },
        {
            "name": "dsa server",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mode": "debug",
            "program": "${workspaceFolder}/dsaserver/main.go",
            "env": {
                "DS_CONFIGPATH": "${workspaceFolder}",
                "DS_DSA_PORT": "11000",
                "DS_DSA_GRPC_PORT": "12000",
                "DS_DSA_GRPC_ADDR": "127.0.0.1:12000",
                "DS_DSC_GRPC_URI": "127.0.0.1:10000",
                "DS_DSA_AgentID": "AgentID0",
                "DSA_TEMPLATE_PORT": "11001",
                "TEMPLATE_READY_REQUIRED": "true",
                "DS_ADVERTISE_IP": "127.0.0.1",
                "DS_DSA_RUNTIME": "process"
            },
            "args": [],
            "showLog": true
        },
        {
            "name": "dstemplate",
            "type": "go",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mode": "debug",
            "program": "${workspaceFolder}/dstemplate/main.go",
            "env": {
                "DSA_TEMPLATE_ADDR": "127.0.0.1:11001",
                "DSA_DS_ADDR": "127.0.0.1:11000",
                "DS_ADVERTISE_IP": "127.0.0.1"
            },
            "args": [],
            "showLog": true
        }
    ]
}
